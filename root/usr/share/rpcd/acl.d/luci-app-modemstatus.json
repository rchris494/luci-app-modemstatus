{
	"luci-app-modemstatus": {
		"description": "Grant access to modem status resources",
		"read": {
			"uci": [
				"modemstatus"
			],
			"ubus": {
				"luci.modemstatus": [
					"status",
					"set_refresh"
				]
			},
			"file": {
				"/usr/bin/sms_tool": [
					"exec"
				]
			}
		},
		"write": {
			"uci": [
				"modemstatus"
			],
			"ubus": {
				"luci.modemstatus": [
					"set_refresh"
				]
			}
		}
	}
}
